# Konfigurasi Publik Frontend (Vite) — Museum Digital Pringgasela Selatan
# PERINGATAN: JANGAN PERNAH meletakkan APPWRITE_API_KEY, UPLOAD_SESSION_SECRET, atau secret lain
# pada variabel berawalan VITE_ karena seluruh nilai VITE_* dibundel ke browser publik.

VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6affdaa0003c416ecdb0
VITE_APPWRITE_DATABASE_ID=museum_digital
VITE_APPWRITE_STORAGE_BUCKET_ID=museum-media
VITE_APPWRITE_ADMIN_TEAM_ID=museum-admins
VITE_APPWRITE_PUBLIC_API_FUNCTION_ID=museum-public-api
VITE_APPWRITE_ADMIN_MEDIA_FUNCTION_ID=museum-admin-media
VITE_APPWRITE_ADMIN_MEDIA_GATEWAY_URL=https://museum-admin-media-pringgasela.appwrite.network
VITE_SITE_URL=https://museum.pringgasela.desa.id
